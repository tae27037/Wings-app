{
  "name": "maison-wigs",
  "productName": "Maison Wigs",
  "description": "Maison Wigs — парики и накладки",
  "author": "Maison Wigs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "chat-proxy": "node server/proxy.mjs",
    "android:add": "cap add android && capacitor-assets generate --android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew assembleDebug",
    "exe:dev": "npm run build && electron .",
    "exe": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.maisonwigs.app",
    "productName": "Maison Wigs",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Maison Wigs" },
    "artifactName": "Maison-Wigs-${version}-${target}.${ext}"
  }
}
